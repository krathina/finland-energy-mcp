# Settings for finland-energy-mcp. All are optional; the values below are the defaults.
#
# How to use: set them as environment variables where the server runs, e.g. when adding it to
# Claude Code:  claude mcp add ... -e FINLAND_ENERGY_TRANSFER_C_PER_KWH=4.2 -- uv ... run ...
# Never put real secrets in this file: it is committed. A local copy named .env is git-ignored.

# --- Household contract (cents per kWh, including VAT; a decimal comma is fine too) ---
# Retailer's margin on top of the spot price (from your electricity contract).
FINLAND_ENERGY_MARGIN_C_PER_KWH=0.49
# Network transfer fee, "siirtomaksu" (from your network company's price list).
FINLAND_ENERGY_TRANSFER_C_PER_KWH=3.5
# Whether VAT is added when the spot price is negative (true/false). Check your contract.
FINLAND_ENERGY_VAT_ON_NEGATIVE=false

# --- Price source: spot-hinta.fi ---
# API address (change only to use a mirror or a local test server).
FINLAND_ENERGY_SPOT_HINTA_BASE_URL=https://api.spot-hinta.fi
# How long to wait for an answer, in seconds.
FINLAND_ENERGY_REQUEST_TIMEOUT_SECONDS=10
# How long to reuse fetched prices, in whole minutes (at least 1: the API's rate limit).
FINLAND_ENERGY_CACHE_MINUTES=15
